{
  "name": "@omnitron-dev/omnitron",
  "version": "0.3.1",
  "description": "Production-grade Titan application supervisor",
  "type": "module",
  "bin": {
    "omnitron": "./dist/cli/omnitron.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./dto/services": {
      "types": "./dist/shared/dto/services.d.ts",
      "default": "./dist/shared/dto/services.js"
    },
    "./dto/events": {
      "types": "./dist/shared/events.d.ts",
      "default": "./dist/shared/events.js"
    },
    "./alerts": {
      "types": "./dist/shared/alert-expression.d.ts",
      "default": "./dist/shared/alert-expression.js"
    },
    "./release-reading": {
      "types": "./dist/shared/release-reading.d.ts",
      "default": "./dist/shared/release-reading.js"
    },
    "./node-check": {
      "types": "./dist/shared/node-check.d.ts",
      "default": "./dist/shared/node-check.js"
    },
    "./audit-outcome": {
      "types": "./dist/shared/audit-outcome.d.ts",
      "default": "./dist/shared/audit-outcome.js"
    },
    "./sync-reading": {
      "types": "./dist/shared/sync-reading.d.ts",
      "default": "./dist/shared/sync-reading.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "default": "./dist/operations.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/stamp-build.mjs dist",
    "build:backend": "tsc -p tsconfig.build.json && node scripts/stamp-build.mjs dist",
    "build:webapp": "pnpm --filter @omnitron/console build",
    "start": "node dist/cli/omnitron.js",
    "up": "node dist/cli/omnitron.js up",
    "down": "node dist/cli/omnitron.js down",
    "migrate": "tsx src/database/migrate.ts",
    "migrate:down": "tsx src/database/migrate.ts --down",
    "typecheck": "tsc --noEmit",
    "typecheck:webapp": "tsc --noEmit -p webapp/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "dependencies": {
    "@kysera/migrations": "^0.10.0",
    "@omnitron-dev/access": "workspace:*",
    "@omnitron-dev/eventemitter": "workspace:*",
    "@omnitron-dev/kb": "workspace:*",
    "@omnitron-dev/titan": "workspace:*",
    "@omnitron-dev/titan-auth": "workspace:*",
    "@omnitron-dev/titan-database": "workspace:*",
    "@omnitron-dev/titan-health": "workspace:*",
    "@omnitron-dev/titan-metrics": "workspace:*",
    "@omnitron-dev/titan-pm": "workspace:*",
    "@omnitron-dev/titan-scheduler": "workspace:*",
    "@omnitron-dev/titan-telemetry-relay": "workspace:*",
    "@xec-sh/core": "^0.11.1",
    "@xec-sh/kit": "^0.11.1",
    "@xec-sh/ops": "^0.11.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "cron-parser": "^5.10.2",
    "esbuild": "^0.28.2",
    "jose": "^6.2.13",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "systeminformation": "^5.33.18",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "happy-dom": "^21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "files": [
    "dist",
    "webapp/dist",
    "data"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omnitron-dev/omni",
    "directory": "apps/omnitron"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
