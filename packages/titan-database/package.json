{
  "name": "@omnitron-dev/titan-database",
  "version": "0.3.1",
  "description": "Database module for Titan framework with Kysely, migrations, RLS, and multi-dialect support",
  "author": "LuxQuant",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/exports/plugins.d.ts",
      "default": "./dist/exports/plugins.js"
    },
    "./coordination": {
      "types": "./dist/exports/coordination.d.ts",
      "default": "./dist/exports/coordination.js"
    },
    "./transaction": {
      "types": "./dist/exports/transaction.d.ts",
      "default": "./dist/exports/transaction.js"
    },
    "./repository": {
      "types": "./dist/exports/repository.d.ts",
      "default": "./dist/exports/repository.js"
    },
    "./migration": {
      "types": "./dist/exports/migration.d.ts",
      "default": "./dist/exports/migration.js"
    },
    "./kysera": {
      "types": "./dist/exports/kysera.d.ts",
      "default": "./dist/exports/kysera.js"
    },
    "./rls": {
      "types": "./dist/exports/rls.d.ts",
      "default": "./dist/exports/rls.js"
    },
    "./dialects": {
      "types": "./dist/exports/dialects.d.ts",
      "default": "./dist/exports/dialects.js"
    },
    "./sqlite": {
      "types": "./dist/exports/sqlite.d.ts",
      "default": "./dist/exports/sqlite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "../../scripts/build-package.sh -p ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kysera/audit": "^0.10.2",
    "@kysera/core": "^0.10.2",
    "@kysera/dialects": "^0.10.2",
    "@kysera/executor": "^0.10.2",
    "@kysera/infra": "^0.10.2",
    "@kysera/migrations": "^0.10.2",
    "@kysera/repository": "^0.10.2",
    "@kysera/rls": "^0.10.2",
    "@kysera/soft-delete": "^0.10.2",
    "@kysera/timestamps": "^0.10.2",
    "@omnitron-dev/eventemitter": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "kysely": "^0.29.8",
    "zod": "^4.6.7",
    "@kysera/dal": "^0.10.2"
  },
  "peerDependencies": {
    "@omnitron-dev/titan": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "mysql2": "^3.20.0",
    "pg": "^8.20.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@omnitron-dev/titan": "workspace:*",
    "@types/node": "^26.6.6",
    "reflect-metadata": "^0.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnitron-dev/omni.git",
    "directory": "packages/titan-database"
  }
}
