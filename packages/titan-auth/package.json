{
  "name": "@omnitron-dev/titan-auth",
  "version": "0.3.1",
  "description": "JWT authentication module for Titan framework",
  "author": "LuxQuant",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preset/shared-session": {
      "types": "./dist/preset/shared-session.d.ts",
      "default": "./dist/preset/shared-session.js"
    },
    "./access": {
      "types": "./dist/access/index.d.ts",
      "default": "./dist/access/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "../../scripts/build-package.sh -p ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omnitron-dev/access": "workspace:*",
    "jose": "^6.2.13",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "@omnitron-dev/titan": "workspace:*"
  },
  "devDependencies": {
    "@omnitron-dev/titan": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
