diff --git a/dist/chunks/tmp-copies.js b/dist/chunks/tmp-copies.js
new file mode 100644
index 0000000000000000000000000000000000000000..14eb937a78c23e9247b1e86bd9a00fdbd8755c5c
--- /dev/null
+++ b/dist/chunks/tmp-copies.js
@@ -0,0 +1,33 @@
+// Omnitron: preserve the existing interrupted-run cleanup when upgrading Vitest.
+import { readdirSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, basename, dirname } from 'node:path';
+import { randomBytes } from 'node:crypto';
+const ownedName = /^vitest-(\d+)-[\w-]{21}$/;
+let checked = false;
+export function tmpCopiesDir() {
+  const root = tmpdir();
+  if (!checked) {
+    checked = true;
+    try {
+      for (const name of readdirSync(root)) {
+        const owner = ownedName.exec(name);
+        if (!owner || Number(owner[1]) === process.pid) continue;
+        try { process.kill(Number(owner[1]), 0); }
+        catch (error) {
+          if (error.code === 'ESRCH') {
+            try { rmSync(join(root, name), { recursive: true, force: true }); } catch {}
+          }
+        }
+      }
+    } catch {}
+  }
+  return join(root, `vitest-${process.pid}-${randomBytes(16).toString('base64url').slice(0, 21)}`);
+}
+export function removeOwnTmpCopies(context) {
+  const dirs = new Set([context._tmpDir, context.coreWorkspaceProject?.tmpDir, ...(context.projects ?? []).map(project => project.tmpDir)]);
+  for (const dir of dirs) {
+    if (!dir || dirname(dir) !== tmpdir() || ownedName.exec(basename(dir))?.[1] !== String(process.pid)) continue;
+    try { rmSync(dir, { recursive: true, force: true }); } catch {}
+  }
+}
