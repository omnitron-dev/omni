{
  "name": "@omnitron-dev/titan-lumen",
  "version": "0.4.8",
  "description": "Titan backend integration module for Lumen documentation and knowledge portal",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "../../scripts/build-package.sh -p ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@omnitron-dev/kb": "workspace:*",
    "@omnitron-dev/lumen-ast": "workspace:*",
    "@omnitron-dev/titan-database": "workspace:*",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@omnitron-dev/netron-protocol": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@omnitron-dev/titan": "workspace:*"
  },
  "devDependencies": {
    "@omnitron-dev/testing": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "@omnitron-dev/titan": "workspace:*",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5",
    "@modelcontextprotocol/client": "^2.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnitron-dev/omni.git",
    "directory": "packages/titan-lumen"
  }
}
