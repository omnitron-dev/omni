{
  "name": "@omnitron-dev/titan-redis",
  "version": "0.3.1",
  "description": "Redis module for Titan framework with connection management, clustering, and health checks",
  "author": "LuxQuant",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "lua"
  ],
  "scripts": {
    "build": "../../scripts/build-package.sh -p ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  },
  "peerDependencies": {
    "@omnitron-dev/titan": "workspace:*"
  },
  "devDependencies": {
    "@omnitron-dev/titan": "workspace:*",
    "@types/node": "26.6.6",
    "reflect-metadata": "^0.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
