{
  // Type-checks the TESTS as well as the sources.
  //
  // The package's own `tsconfig.json` drives the BUILD, so it includes `src`
  // only — which left every test file unchecked. That is where the dangerous
  // form of this hole lives: a test importing a type its module does not
  // export, hidden behind a cast, stays green under vitest (which strips
  // types) and is seen by nothing.
  //
  "extends": ["./tsconfig.json", "../../tsconfig.vitest.json"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.typecheck.tsbuildinfo",
    // The build pins rootDir to `src`; including `test` needs it widened.
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  // `test/runtime/**` holds the Bun and Deno runners, which import `bun:test`
  // and remote Deno modules — unresolvable under a Node typecheck by
  // construction, not by neglect.
  "exclude": ["node_modules/.pnpm", "dist", "test/runtime/**"]
}
