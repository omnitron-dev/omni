{
  "name": "@omnitron-dev/titan-health",
  "version": "0.3.1",
  "description": "Health check module for Titan framework with extensible indicators",
  "author": "LuxQuant",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "../../scripts/build-package.sh -p ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@omnitron-dev/titan": "workspace:*",
    "ioredis": "^5.8.2 || ^6.0.0",
    "kysely": "^0.29.4"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "devDependencies": {
    "@omnitron-dev/titan": "workspace:*",
    "@types/node": "26.6.6",
    "reflect-metadata": "^0.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
