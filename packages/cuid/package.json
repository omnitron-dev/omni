    "directory": "packages/common"
  },
  "bugs": {
    "url": "https://github.com/omnitron-dev/omni/issues"
  },
  "homepage": "https://github.com/omnitron-dev/omni/tree/main/packages/common#readme",
  "dependencies": {
    "@noble/hashes": "2.4.0"
  }
}
