{
  "name": "@omnitron-dev/titan-scheduler",
  "version": "0.2.0",
  "description": "Cron, interval, and timeout job scheduling with persistence and metrics for Titan",
  "author": "LuxQuant",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "default": "./dist/persistence/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist node_modules/.tmp && tsc -p ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omnitron-dev/eventemitter": "workspace:*",
    "cron-parser": "^5.10.0",
    "node-cron": "^4.6.0"
  },
  "peerDependencies": {
    "@omnitron-dev/titan": "workspace:*",
    "kysely": "^0.29.4"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/node-cron": "^3.0.11",
    "reflect-metadata": "^0.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
