{
  "$schema": "https://v2-9-12.turborepo.dev/schema.json",
  "globalDependencies": ["package.json", "pnpm-workspace.yaml", "tsconfig*.json", "scripts/build-package.sh"],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "outputLogs": "new-only"
    },
    "build:titan": {
      "dependsOn": [
        "@omnitron-dev/titan#build",
        "@omnitron-dev/eventemitter#build",
        "@omnitron-dev/testing#build"
      ],
      "outputs": [
        "dist/titan/**"
      ],
      "outputLogs": "new-only"
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build",
        "^test"
      ],
      "outputs": [],
      "env": ["TEST_*", "OMNITRON_TEST_*", "OMNITRON_HOME", "USE_MOCK_REDIS"],
      "passThroughEnv": ["DOCKER_*", "NODE_OPTIONS", "TMPDIR", "TMP", "TEMP"]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {},
    "kb:extract": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "src/**/*.ts",
        "kb/kb.config.ts"
      ],
      "outputs": [
        "kb/generated/**"
      ],
      "outputLogs": "new-only"
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "dist/e2e-report.json"
      ],
      "cache": false
    }
  }
}
