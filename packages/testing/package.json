{
  "name": "@omnitron-dev/testing",
  "version": "0.3.1",
  "description": "Cross-runtime testing utilities",
  "author": "LuxQuant",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./async": {
      "types": "./dist/async/index.d.ts",
      "import": "./dist/async/index.js",
      "require": "./dist/async/index.cjs"
    },
    "./docker": {
      "types": "./dist/docker/index.d.ts",
      "import": "./dist/docker/index.js",
      "require": "./dist/docker/index.cjs"
    },
    "./runtime/vitest": {
      "types": "./dist/runtime/node-adapter.d.ts",
      "import": "./dist/runtime/node-adapter.js"
    },
    "./runtime/bun": {
      "types": "./dist/runtime/bun-adapter.d.ts",
      "import": "./dist/runtime/bun-adapter.js"
    },
    "./runtime/deno": {
      "types": "./dist/runtime/deno-adapter.d.ts",
      "import": "./dist/runtime/deno-adapter.js"
    },
    "./runtime/node": {
      "types": "./dist/runtime/node-adapter.d.ts",
      "import": "./dist/runtime/node-adapter.js"
    },
    "./titan": {
      "types": "./dist/titan/index.d.ts",
      "import": "./dist/titan/index.js",
      "require": "./dist/titan/index.cjs"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js",
      "require": "./dist/helpers/index.cjs"
    },
    "./performance": {
      "types": "./dist/performance/index.d.ts",
      "import": "./dist/performance/index.js",
      "require": "./dist/performance/index.cjs"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js",
      "require": "./dist/env.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "../../scripts/build-package.sh -p tsconfig.json",
    "build:titan": "rm -rf dist/titan && NODE_OPTIONS='--max-old-space-size=8192' tsc -p tsconfig.titan.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:bun": "bun test src/**/*.test.ts",
    "test:deno": "deno test --allow-all src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kysera/testing": "^0.10.0",
    "@types/node": "^26.6.6",
    "kysely": "^0.29.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@omnitron-dev/eventemitter": "workspace:*",
    "@omnitron-dev/titan": "workspace:*",
    "@omnitron-dev/titan-database": "workspace:*",
    "@omnitron-dev/titan-pm": "workspace:*",
    "@omnitron-dev/titan-redis": "workspace:*",
    "@types/bun": "^1.4.4",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "peerDependencies": {
    "@omnitron-dev/eventemitter": "workspace:*",
    "@omnitron-dev/titan": "workspace:*",
    "@omnitron-dev/titan-database": "workspace:*",
    "@omnitron-dev/titan-pm": "workspace:*",
    "@omnitron-dev/titan-redis": "workspace:*",
    "bun": "*",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@omnitron-dev/eventemitter": {
      "optional": true
    },
    "@omnitron-dev/titan": {
      "optional": true
    },
    "@omnitron-dev/titan-database": {
      "optional": true
    },
    "@omnitron-dev/titan-pm": {
      "optional": true
    },
    "@omnitron-dev/titan-redis": {
      "optional": true
    },
    "bun": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "pino": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devgrid/devgrid.git",
    "directory": "packages/testing"
  },
  "keywords": [
    "testing",
    "cross-runtime",
    "bun",
    "deno",
    "node",
    "vitest",
    "test-utilities"
  ],
  "publishConfig": {
    "access": "public"
  }
}
