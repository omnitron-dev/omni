{
  "name": "@omnitron-dev/cuid",
  "version": "0.3.1",
  "description": "CUID implementation",
  "author": "LuxQuant",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "../../scripts/build-package.sh -p ./tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:node": "vitest run",
    "test:bun": "bun test test/primitives.spec.ts test/list-buffer.spec.ts test/entries.spec.ts test/omit.spec.ts test/predicates.spec.ts test/promise.spec.ts test/timed-map-bun-compat.spec.ts",
    "test:all": "npm run test:node && npm run test:bun",
    "benchmark": "tsx benchmark/index.ts",
    "bench": "tsx benchmark/index.ts"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/benchmark": "^2.1.5",
    "@types/bun": "latest",
    "@types/node": "26.6.6",
    "benchmark": "^2.1.4",
    "nanoid": "^6.0.2",
    "short-uuid": "^6.0.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "uuid": "^14.0.3",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "keywords": [
    "utils",
    "common",
    "helpers",
    "typescript",
    "utilities",
    "predicates",
    "type-checking",
    "validation",
    "primitives",
    "functions",
    "browser",
    "node",
    "cross-platform",
    "type-guards",
    "utility-functions",
    "timed-map"
