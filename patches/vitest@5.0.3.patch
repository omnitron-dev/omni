+// Patched (omnitron-dev): the tmp module copies of a run that never closed.
+// close() removes them since 5.0.3 (vitest-dev/vitest#11248). A run ended by
+// SIGINT or SIGTERM exits from the logger's handler without closing, and one
+// ended by SIGKILL, a crash or a lost terminal runs no code at all: each left
+// `$TMPDIR/<nanoid>/<environment>` behind for good. The directory now names
+// the process that owns it; a signal exit removes the process's own
+// directories synchronously, and every start removes those whose owner is no
+// longer alive (`isProcessAlive`, below, the lock's own test). Liveness, not
+// age: a live run's copies are never touched, however long it has been idle.
+const TMP_COPIES_DIR_RE = /^vitest-(\d+)-[\w-]{21}$/;
+function tmpCopiesDir() {
+	return join(tmpdir(), `vitest-${process.pid}-${nanoid()}`);
+}
+let tmpCopiesOfEndedRunsRemoved = false;
+function removeTmpCopiesOfEndedRuns() {
+	if (tmpCopiesOfEndedRunsRemoved) return;
+	tmpCopiesOfEndedRunsRemoved = true;
+	const root = tmpdir();
+	let names;
+	try {
+		names = readdirSync(root);
+	} catch {
+		return;
+	}
+	for (const name of names) {
+		const owner = TMP_COPIES_DIR_RE.exec(name);
+		if (!owner) continue;
+		const pid = Number(owner[1]);
+		if (pid === process.pid || isProcessAlive(pid)) continue;
+		try {
+			fs.rmSync(join(root, name), {
+				recursive: true,
+				force: true
+			});
+		} catch {}
+	}
+}
 
