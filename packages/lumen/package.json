{
  "name": "@omnitron-dev/lumen",
  "version": "0.3.5",
  "description": "Static site generator, Corpus Graph verification engine, and CLI for Lumen",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "lumen": "./bin/lumen.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "../../scripts/build-package.sh -p ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@omnitron-dev/lumen-ast": "workspace:*",
    "@omnitron-dev/lumen-ui": "workspace:*",
    "@omnitron-dev/prism": "workspace:*",
    "commander": "^15.0.0",
    "import-meta-resolve": "4.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "zod": "^4.6.7",
    "pagefind": "1.6.0",
    "@omnitron-dev/common": "workspace:*",
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "^5.0.5",
    "@modelcontextprotocol/client": "^2.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnitron-dev/omni.git",
    "directory": "packages/lumen"
  }
}
