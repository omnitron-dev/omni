{
  "name": "omnitron-dev",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build && turbo build:titan",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:down": "docker compose -f docker-compose.test.yml down -v",
    "test:ci": "docker compose -f docker-compose.test.yml up -d --wait && turbo test; docker compose -f docker-compose.test.yml down -v",
    "lint": "NODE_OPTIONS='--max-old-space-size=8192' eslint \"{apps,packages}/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "NODE_OPTIONS='--max-old-space-size=8192' eslint --fix \"{apps,packages}/**/*.{js,jsx,ts,tsx}\"",
    "lint:print": "eslint --print-config apps/omnitron/src/index.ts > eslint-show-config.json",
    "fm:check": "prettier --check \"{apps,packages}/**/*.{js,jsx,ts,tsx}\"",
    "check:scans": "node scripts/run-checks.mjs",
    "fm:fix": "prettier --write \"{apps,packages}/**/*.{js,jsx,ts,tsx}\"",
    "fix:all": "pnpm lint:fix && pnpm fm:fix",
    "cleanup": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +",
    "changeset": "changeset",
    "ai-prompt": "ts-node scripts/gen-aiprompt.ts",
    "publish": "ts-node scripts/publish.ts",
    "transform-hugeicons": "tsx scripts/transform-hugeicons.ts",
    "link:global": "cd apps/omnitron && pnpm link --global",
    "unlink:global": "pnpm uninstall --global @omnitron-dev/omnitron",
    "kb:extract": "turbo kb:extract",
    "kb:index": "cd apps/omnitron && tsx src/commands/kb.ts index",
    "check:packages": "node scripts/check-package-exports.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@omnitron-dev/omnitron": "workspace:*",
    "@types/add": "^2.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.6.6",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@xec-sh/kit": "^0.11.1",
    "add": "^2.0.9",
    "eslint": "10.13.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12.16.1"
  },
  "dependencies": {
    "framer-motion": "^14.7.1",
    "systeminformation": "^5.33.18"
  }
}
