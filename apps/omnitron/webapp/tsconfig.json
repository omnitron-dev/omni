{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    // Source contracts below remain independent of daemon services, database
    // execution and process ownership. Console builds need no server decorators.
    "skipLibCheck": true,
    // Vite emits `dist/`; this project is the typecheck step of `pnpm build`
    // and must not emit. It used to declare `outDir: "dist"`, which wrote a
    // second, unbundled copy of the whole app into `dist/src/` — inside the
    // directory nginx serves. Under TypeScript 7 the same setting became a
    // hard error (TS5011: rootDir must be explicit), so `tsc -b` exited 2 and
    // `&& vite build` never ran: `pnpm build` had been broken outright. It
    // went unnoticed because the daemon builds the console by invoking
    // `vite build` directly (webapp.service.ts), bypassing this step.
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "paths": {
      "src/*": ["./src/*"],
      "@omnitron-dev/omnitron/dto/services": ["../src/shared/dto/services.ts"],
      "@omnitron-dev/omnitron/sync-reading": ["../src/shared/sync-reading.ts"]
    }
  },
  "include": ["src"]
}
