{
  "name": "@omnitron-dev/titan-metrics",
  "version": "0.3.1",
  "description": "Titan-native metrics module \u2014 counters, gauges, histograms, time-series storage",
  "author": "LuxQuant",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "../../scripts/build-package.sh -p ./tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@omnitron-dev/titan": "workspace:*",
    "kysely": "^0.29.7"
  },
  "devDependencies": {
    "@omnitron-dev/titan": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "kysely": "^0.29.7",
    "better-sqlite3": "^13.0.3"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    }
  }
}
