{
  "imports": {
    // The runtime adapters live in a sibling workspace package that `common`
    // does not depend on. Deno resolves through this map rather than
    // node_modules, so the mapping is enough here; the Bun runner still needs
    // the devDependency.
    "@omnitron-dev/testing/runtime/deno": "../testing/dist/runtime/deno-adapter.js",
    // The spec files this runner imports do `import { describe } from 'vitest'`,
    // which cannot work under Deno. The adapter provides the same names, and an
    // import map is the one place that can say so without editing every spec.
    "vitest": "../testing/dist/runtime/deno-adapter.js"
  },
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window"],
    "strict": true
  },
  "lint": {
    "files": {
      "include": ["src/", "test/"],
      "exclude": ["dist/"]
    },
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"]
    }
  },
  "fmt": {
    "files": {
      "include": ["src/", "test/"],
      "exclude": ["dist/"]
    },
    "options": {
      "useTabs": false,
      "lineWidth": 120,
      "indentWidth": 2,
      "semiColons": true,
      "singleQuote": true,
      "proseWrap": "preserve"
    }
  },
  "test": {
    "include": ["test/runtime/deno-all.test.ts"],
    "exclude": ["test/runtime/bun.test.ts", "test/runtime/node.test.ts", "test/runtime/bun-all.test.ts"]
  },
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --unstable-sloppy-imports",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check src/**/*.ts test/**/*.ts"
  }
}