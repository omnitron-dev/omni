{
  "name": "@omnitron-dev/titan-storage",
  "version": "0.3.0",
  "description": "Object storage adapters and lifecycle integration for Titan applications",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "../../scripts/build-package.sh -p ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@smithy/node-http-handler": "^4.13.0"
  },
  "peerDependencies": {
    "@omnitron-dev/titan": "workspace:*"
  },
  "devDependencies": {
    "@omnitron-dev/titan": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "license": "MIT"
}
