{
  "name": "@omnitron-dev/lumen-ast",
  "version": "0.3.5",
  "description": "Pure isomorphic prism-doc/2 AST compiler, math environments, Shiki/Twoslash highlighter, and multi-target emitters",
  "type": "module",
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/execution/index.ts",
      "src/execution/limits.ts",
      "src/typst/index.ts"
    ],
    "format": [
      "esm"
    ],
    "dts": true,
    "sourcemap": true,
    "clean": true,
    "treeshake": true,
    "noExternal": [
      "micromark-extension-math"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./execution": {
      "types": "./dist/execution/index.d.ts",
      "import": "./dist/execution/index.js",
      "default": "./dist/execution/index.js"
    },
    "./execution/limits": {
      "types": "./dist/execution/limits.d.ts",
      "import": "./dist/execution/limits.js",
      "default": "./dist/execution/limits.js"
    },
    "./typst": {
      "types": "./dist/typst/index.d.ts",
      "node": "./dist/typst/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "fonts"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "mdast-util-directive": "^3.2.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.2.1",
    "mermaid": "^12.2.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "shiki": "^4.6.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zod": "^4.6.7",
    "yaml": "^2.9.1",
    "@omnitron-dev/access": "workspace:*",
    "hast-util-raw": "^9.2.0",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.6",
    "@types/hast": "^3.0.5",
    "mdast-util-to-hast": "^13.2.1",
    "quickjs-emscripten-core": "0.32.0",
    "@jitl/quickjs-singlefile-browser-release-sync": "0.32.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "tex2typst": "0.6.2",
    "fontkit": "3.0.0"
  },
  "devDependencies": {
    "micromark-extension-math": "^3.1.0",
    "tsup": "^9.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "vitest": "^5.0.5",
    "pdfjs-dist": "6.5.438"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnitron-dev/omni.git",
    "directory": "packages/lumen-ast"
  }
}
